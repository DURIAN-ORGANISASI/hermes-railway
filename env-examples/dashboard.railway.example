# MODE DASHBOARD — masukkan variabel ini ke Railway > Hermes-Dashboard > Variables.
# Ganti seluruh kredensial contoh; jangan pakai nilai ini apa adanya.
DEPLOY_MODE=dashboard
USERNAME=ganti_dengan_username
PASSWORD=GANTI_DENGAN_PASSWORD_UNIK_YANG_KUAT
SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER
HERMES_HOME=/opt/data
TZ=Asia/Jakarta
# Pastikan domain Railway di Settings > Networking menargetkan port ini.
PORT=8080
